(version 1)

# The SK6812MINI-E reverse-mount footprints (D2-D7) have a light cutout on
# Edge.Cuts. The project footprint (lib/Dachshund70.pretty) uses a plain
# 3.4 x 3.4 mm cutout with 0.5 mm corners: its pads sit 0.35 mm from the edge
# and the nearest track about 0.36 mm, so the board-wide 0.5 mm edge rule
# can't apply here. 0.3 mm is the fabs' usual minimum for routed edges.
(rule "LED cutout edge clearance"
  (constraint edge_clearance (min 0.3mm))
  (condition "B.memberOfFootprint('D2') || B.memberOfFootprint('D3') || B.memberOfFootprint('D4') || B.memberOfFootprint('D5') || B.memberOfFootprint('D6') || B.memberOfFootprint('D7')"))

# SW1 (PCM12) is an edge-mount slide switch: its no-net mounting tabs sit at
# the board edge on purpose.
(rule "SW1 edge-mount switch"
  (constraint edge_clearance (min 0mm))
  (condition "A.memberOfFootprint('SW1')"))

# The spacebar row carries two alternative layouts on purpose: a 6.25u
# spacebar (SW615, stabiliser ST5) or split 2.25u + 1.25u + 2.75u keys
# (SW604, SW606 with stabilisers ST4/ST6). Only one set of switches gets
# soldered, so their courtyards, holes and silk overlap, and ST4 and ST6
# share their stabiliser holes (aligned in PR #34; those two co-located
# holes are DRC exclusions in the .kicad_pro, since a rule can't waive them).
(rule "Alternate spacebar courtyards"
  (constraint courtyard_clearance)
  (severity ignore)
  (condition "(A.memberOfFootprint('SW604') || A.Reference == 'SW604' || A.memberOfFootprint('SW606') || A.Reference == 'SW606' || A.memberOfFootprint('SW615') || A.Reference == 'SW615' || A.memberOfFootprint('ST4') || A.Reference == 'ST4' || A.memberOfFootprint('ST5') || A.Reference == 'ST5' || A.memberOfFootprint('ST6') || A.Reference == 'ST6') && (B.memberOfFootprint('SW604') || B.Reference == 'SW604' || B.memberOfFootprint('SW606') || B.Reference == 'SW606' || B.memberOfFootprint('SW615') || B.Reference == 'SW615' || B.memberOfFootprint('ST4') || B.Reference == 'ST4' || B.memberOfFootprint('ST5') || B.Reference == 'ST5' || B.memberOfFootprint('ST6') || B.Reference == 'ST6')"))

(rule "Alternate spacebar silk"
  (constraint silk_clearance)
  (severity ignore)
  (condition "(A.memberOfFootprint('SW604') || A.memberOfFootprint('SW606') || A.memberOfFootprint('SW615') || A.memberOfFootprint('ST4') || A.memberOfFootprint('ST5') || A.memberOfFootprint('ST6')) && (B.memberOfFootprint('SW604') || B.memberOfFootprint('SW606') || B.memberOfFootprint('SW615') || B.memberOfFootprint('ST4') || B.memberOfFootprint('ST5') || B.memberOfFootprint('ST6'))"))
