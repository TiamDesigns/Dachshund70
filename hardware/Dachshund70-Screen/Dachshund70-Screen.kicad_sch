	(text "Dachshund70 screen board: 5 V for the Sharp LS027B7DH01 memory LCD (U1, L1, C1, C2) and panel socket J1."
		(exclude_from_sim no)
		(at 25.4 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "46c72c9a-6ff3-4392-9bf2-b3476c5d3dbb")
	)
	(text "J2: 8-pin 0.5 mm FFC to the mainboard's J4 (same-side contacts). J2 pin n = J4 pin 9 - n."
		(exclude_from_sim no)
		(at 25.4 176.53 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "abcc5d7b-58ea-4860-9334-0075540d5212")
	)
	(text "J4-8 (VLCD_EN) enables U1; R1 holds it high. EXTMODE high: VCOM follows the EXTCOMIN pulse."
		(exclude_from_sim no)
		(at 25.4 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1f030544-dd59-4d54-9a2a-9e02b4456d50")
	)
	(text "C3 (VDD), C4 (VDDA) and C5 (DISP) are the capacitors from Sharp's specification, next to J1."
		(exclude_from_sim no)
		(at 25.4 184.15 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9c806b87-3cfc-440c-accc-d5a32d178322")
	)
	(text "J1 pin n = panel pin 11 - n: the panel's tail folds back under the glass."
		(exclude_from_sim no)
		(at 25.4 187.96 0)
		(effects
			(font
